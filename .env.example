# Copy to .env and fill in real values, or export these in your shell/deployment.
# Each account's variable name defaults to {PROVIDER}_{ACCOUNT}_API_KEY,
# unless overridden with `api_key_env:` in config.yaml.

# Used by litellm-config.example.yaml (general_settings.master_key) AND by
# ai-gateway/config.yaml (litellm.proxy_api_key_env) if you enable proxy
# auth. Leave both sides unset to keep LiteLLM unauthenticated.
LITELLM_MASTER_KEY=

GEMINI_PERSONAL_API_KEY=
GEMINI_WORK_API_KEY=
GEMINI_BACKUP_KEY_CUSTOM_NAME=

GROQ_PRIMARY_API_KEY=

OPENROUTER_FREE_API_KEY=

# Optional overrides
AI_GATEWAY_CONFIG=config.yaml
AI_GATEWAY_LOG_LEVEL=INFO
